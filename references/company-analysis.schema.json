{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company Analysis Schema v1.3.0",
  "description": "Machine-readable structure for cross-stage handoff of company and hiring team intelligence. Stage 10 reads this directly — only use facts where confidence >= medium in the cover letter. v1.3.0 renamed 'product_strategy' to 'strategy_direction' so the field fits any role (product, technical, commercial, design, or operations), not just product management.",
  "type": "object",
  "required": ["schema_version", "company", "role_context", "metadata"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.3.0"
    },
    "company": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "role_context": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "department": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["generated_at", "generator", "content_hash"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "generator": { "type": "string" },
        "content_hash": { "type": "string" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "inside_scoop": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence_level" },
            "sources": { "type": "array", "items": { "type": "string" } }
          }
        },
        "representative_quotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": { "type": "string" },
              "source": { "type": "string" },
              "date": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" }
            }
          }
        }
      }
    },
    "mission_and_problem": {
      "type": "object",
      "properties": {
        "mission": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence_level" },
            "source_url": { "type": "string", "format": "uri" }
          }
        },
        "core_problems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "problem": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "market_position": {
      "type": "object",
      "properties": {
        "position": { "type": "string" },
        "competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" }
            }
          }
        },
        "differentiators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "strategy_direction": {
      "type": "object",
      "description": "The company's strategic direction and where it's headed. For a product or technical role this is product/technology strategy; for a commercial role it's market and go-to-market strategy; for an operations or G&A role it's the operating model and org strategy. Capture whichever framing the role makes relevant.",
      "properties": {
        "confirmed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strategy": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "inferred": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strategy": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "equity": {
      "type": "object",
      "properties": {
        "total_raised": { "type": "string" },
        "last_round": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "amount": { "type": "string" },
            "date": { "type": "string" },
            "lead_investor": { "type": "string" },
            "other_investors": { "type": "array", "items": { "type": "string" } },
            "confidence": { "$ref": "#/$defs/confidence_level" },
            "source_url": { "type": "string", "format": "uri" }
          }
        },
        "estimated_valuation": {
          "type": "object",
          "properties": {
            "range": { "type": "string" },
            "source": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence_level" }
          }
        },
        "ipo_acquisition_outlook": {
          "type": "object",
          "properties": {
            "assessment": { "type": "string" },
            "confidence": { "$ref": "#/$defs/confidence_level" }
          }
        }
      }
    },
    "interview_intel": {
      "type": "object",
      "properties": {
        "likely_challenges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "challenge": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "talking_points": { "type": "array", "items": { "type": "string" } },
        "recent_milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "milestone": { "type": "string" },
              "date": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" },
              "source_url": { "type": "string", "format": "uri" }
            }
          }
        },
        "red_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "flag": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" }
            }
          }
        }
      }
    },
    "hiring_team": {
      "type": "object",
      "description": "Profiles of the likely hiring manager and team members for this specific role.",
      "properties": {
        "identified": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "title", "confidence"],
            "properties": {
              "name": { "type": "string" },
              "title": { "type": "string" },
              "role_in_hiring": {
                "type": "string",
                "enum": ["hiring manager", "likely interviewer", "recruiter", "executive sponsor", "unknown"]
              },
              "tenure_at_company": { "type": "string" },
              "prior_background": { "type": "string" },
              "public_signals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "signal": { "type": "string" },
                    "source_url": { "type": "string", "format": "uri" },
                    "confidence": { "$ref": "#/$defs/confidence_level" }
                  }
                }
              },
              "personality_profile": {
                "type": "object",
                "properties": {
                  "summary": { "type": "string" },
                  "confidence": { "$ref": "#/$defs/confidence_level" }
                }
              },
              "application_implications": {
                "type": "string",
                "description": "How knowledge of this person should shape the resume, cover letter, or interview prep"
              },
              "confidence": { "$ref": "#/$defs/confidence_level" }
            }
          }
        },
        "identification_status": {
          "type": "string",
          "description": "e.g., 'Hiring manager identified with high confidence', 'Team partially identified', 'Could not identify hiring manager'"
        }
      }
    },
    "hiring_problem": {
      "type": "object",
      "description": "Synthesized hiring problem statement produced at end of Stage 2. Primary editorial lens for all downstream stages.",
      "properties": {
        "primary_problem": { "type": "string" },
        "secondary_goals": { "type": "array", "items": { "type": "string" } },
        "implied_urgency": { "type": "string" },
        "bad_hire_looks_like": { "type": "string" },
        "resolved_jd_phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phrase": { "type": "string" },
              "resolved_meaning": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "confidence_level": {
      "type": "string",
      "enum": ["high", "medium", "low", "speculation"],
      "description": "high = multiple corroborating sources; medium = single credible source or strong inference; low = single weak signal; speculation = educated guess with no direct evidence"
    }
  }
}
